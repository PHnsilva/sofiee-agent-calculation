{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1.0.0",
  "purpose": "MCP tool contracts for deterministic calculation; schema presence does not provide an execution engine.",
  "errorSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sofiee-agent-calculation.local/contracts/v1/error.schema.json",
    "type": "object", "additionalProperties": false,
    "required": ["contractVersion", "code", "message", "retryable"],
    "properties": {
      "contractVersion": { "const": "1.0.0" },
      "code": { "enum": ["invalid_request", "invalid_expression", "unsupported_operation", "domain_error", "division_by_zero", "unit_mismatch", "insufficient_data", "limit_exceeded", "unavailable", "internal_error"] },
      "message": { "type": "string", "minLength": 1, "maxLength": 500 },
      "retryable": { "type": "boolean" }
    }
  },
  "tools": [
    {
      "name": "calculation.evaluate",
      "sideEffects": false,
      "description": "Evaluate closed arithmetic operations over decimal-string operands; never interpret input as source code.",
      "errorCodes": ["invalid_request", "unsupported_operation", "domain_error", "division_by_zero", "limit_exceeded", "unavailable", "internal_error"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/evaluate.input.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "operation", "operands", "domain", "precision"],
        "properties": {
          "contractVersion": { "const": "1.0.0" },
          "operation": { "enum": ["add", "subtract", "multiply", "divide", "power", "root", "percentage", "ratio"] },
          "operands": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "pattern": "^-?[0-9]+([.][0-9]+)?$", "maxLength": 128 } },
          "domain": { "enum": ["real", "complex"] },
          "precision": { "type": "object", "additionalProperties": false, "required": ["mode", "decimalPlaces"], "properties": { "mode": { "enum": ["exact", "decimal"] }, "decimalPlaces": { "type": "integer", "minimum": 0, "maximum": 15 } } }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/evaluate.result.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "status", "operation", "value", "unit", "method", "assumptions", "errorBound"],
        "properties": {
          "contractVersion": { "const": "1.0.0" },
          "status": { "enum": ["exact", "approximate", "insufficient_data", "unsupported", "ambiguous"] },
          "operation": { "type": "string", "minLength": 1, "maxLength": 40 },
          "value": { "type": "string", "maxLength": 1000 },
          "unit": { "type": "string", "maxLength": 100 },
          "method": { "type": "string", "minLength": 1, "maxLength": 500 },
          "assumptions": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 500 } },
          "errorBound": { "type": "string", "maxLength": 100 }
        }
      },
      "examples": {
        "validInput": { "contractVersion": "1.0.0", "operation": "divide", "operands": ["1", "3"], "domain": "real", "precision": { "mode": "decimal", "decimalPlaces": 8 } },
        "invalidInput": { "contractVersion": "1.0.0", "operation": "divide", "operands": ["1", "0"], "domain": "real", "precision": { "mode": "decimal", "decimalPlaces": 80 }, "python": "import os" },
        "validResult": { "contractVersion": "1.0.0", "status": "approximate", "operation": "divide", "value": "0.33333333", "unit": "", "method": "decimal division", "assumptions": [], "errorBound": "<0.00000001" },
        "error": { "contractVersion": "1.0.0", "code": "division_by_zero", "message": "O divisor deve ser diferente de zero.", "retryable": false }
      }
    },
    {
      "name": "calculation.symbolic",
      "sideEffects": false,
      "description": "Request a supported symbolic operation over mathematical text, not executable code.",
      "errorCodes": ["invalid_request", "invalid_expression", "unsupported_operation", "domain_error", "insufficient_data", "limit_exceeded", "unavailable", "internal_error"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/symbolic.input.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "operation", "expression", "variable", "domain", "substitutions", "precision"],
        "properties": {
          "contractVersion": { "const": "1.0.0" },
          "operation": { "enum": ["simplify", "substitute", "solve", "limit", "derivative", "integral"] },
          "expression": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "variable": { "type": "string", "minLength": 1, "maxLength": 64 },
          "domain": { "enum": ["real", "complex"] },
          "substitutions": { "type": "array", "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 64 }, "value": { "type": "string", "pattern": "^-?[0-9]+([.][0-9]+)?$", "maxLength": 128 } } } },
          "precision": { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/symbolic.result.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "status", "operation", "expression", "value", "domain", "conditions"],
        "properties": {
          "contractVersion": { "const": "1.0.0" },
          "status": { "enum": ["exact", "approximate", "insufficient_data", "unsupported", "ambiguous"] },
          "operation": { "type": "string", "minLength": 1, "maxLength": 40 },
          "expression": { "type": "string", "maxLength": 4000 },
          "value": { "type": "string", "maxLength": 4000 },
          "domain": { "enum": ["real", "complex"] },
          "conditions": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } }
        }
      },
      "examples": {
        "validInput": { "contractVersion": "1.0.0", "operation": "derivative", "expression": "x^2", "variable": "x", "domain": "real", "substitutions": [], "precision": 0 },
        "invalidInput": { "contractVersion": "1.0.0", "operation": "execute_python", "expression": "__import__('os')", "variable": "x", "domain": "real", "substitutions": [], "precision": 0 },
        "validResult": { "contractVersion": "1.0.0", "status": "exact", "operation": "derivative", "expression": "x^2", "value": "2*x", "domain": "real", "conditions": [] },
        "error": { "contractVersion": "1.0.0", "code": "invalid_expression", "message": "A expressão não pertence à gramática matemática suportada.", "retryable": false }
      }
    },
    {
      "name": "calculation.convertUnits",
      "sideEffects": false,
      "description": "Convert a numeric quantity only when source and target units are recognized and dimensionally compatible.",
      "errorCodes": ["invalid_request", "unit_mismatch", "unsupported_operation", "limit_exceeded", "unavailable", "internal_error"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/convert-units.input.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "amount", "sourceUnit", "targetUnit", "decimalPlaces"],
        "properties": {
          "contractVersion": { "const": "1.0.0" },
          "amount": { "type": "string", "pattern": "^-?[0-9]+([.][0-9]+)?$", "maxLength": 128 },
          "sourceUnit": { "type": "string", "minLength": 1, "maxLength": 64 },
          "targetUnit": { "type": "string", "minLength": 1, "maxLength": 64 },
          "decimalPlaces": { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/convert-units.result.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "status", "originalAmount", "convertedAmount", "sourceUnit", "targetUnit", "precision"],
        "properties": {
          "contractVersion": { "const": "1.0.0" },
          "status": { "enum": ["exact", "approximate", "unsupported", "insufficient_data"] },
          "originalAmount": { "type": "string", "maxLength": 128 },
          "convertedAmount": { "type": "string", "maxLength": 128 },
          "sourceUnit": { "type": "string", "maxLength": 64 },
          "targetUnit": { "type": "string", "maxLength": 64 },
          "precision": { "type": "string", "maxLength": 100 }
        }
      },
      "examples": {
        "validInput": { "contractVersion": "1.0.0", "amount": "1.5", "sourceUnit": "km", "targetUnit": "m", "decimalPlaces": 2 },
        "invalidInput": { "contractVersion": "1.0.0", "amount": "1.5", "sourceUnit": "kg", "targetUnit": "m", "decimalPlaces": -1 },
        "validResult": { "contractVersion": "1.0.0", "status": "exact", "originalAmount": "1.5", "convertedAmount": "1500", "sourceUnit": "km", "targetUnit": "m", "precision": "exact" },
        "error": { "contractVersion": "1.0.0", "code": "unit_mismatch", "message": "As unidades não têm dimensão compatível.", "retryable": false }
      }
    }
  ]
}
