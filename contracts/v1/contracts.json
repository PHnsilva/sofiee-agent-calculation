{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1.2.0",
  "purpose": "MCP tool contracts for deterministic calculation; schema presence does not provide an execution engine.",
  "errorSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sofiee-agent-calculation.local/contracts/v1/error.schema.json",
    "type": "object", "additionalProperties": false,
    "required": ["contractVersion", "code", "message", "retryable"],
    "properties": {
      "contractVersion": { "const": "1.2.0" },
      "code": { "enum": ["invalid_request", "invalid_expression", "unsupported_operation", "domain_error", "division_by_zero", "unit_mismatch", "insufficient_data", "limit_exceeded", "unavailable", "internal_error"] },
      "message": { "type": "string", "minLength": 1, "maxLength": 500 },
      "retryable": { "type": "boolean" }
    }
  },
  "tools": [
    {
      "name": "calculation.evaluate",
      "sideEffects": false,
      "description": "Evaluate closed arithmetic operations over decimal-string operands; dot or comma is the single decimal separator, and input is never source code.",
      "errorCodes": ["invalid_request", "unsupported_operation", "domain_error", "division_by_zero", "limit_exceeded", "unavailable", "internal_error"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/evaluate.input.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "operation", "operands", "domain", "precision"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "operation": { "enum": ["add", "subtract", "multiply", "divide", "power", "root", "percentage", "percentage_change", "ratio"] },
          "operands": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "pattern": "^-?(?:[0-9]+(?:[.,][0-9]+)?|[0-9]+/[1-9][0-9]*)$", "maxLength": 128 } },
          "domain": { "enum": ["real", "complex"] },
          "precision": { "type": "object", "additionalProperties": false, "required": ["mode", "decimalPlaces"], "properties": { "mode": { "enum": ["exact", "decimal"] }, "decimalPlaces": { "type": "integer", "minimum": 0, "maximum": 15 } } }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/evaluate.result.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "status", "operation", "value", "unit", "method", "assumptions", "errorBound"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "status": { "enum": ["exact", "approximate", "insufficient_data", "unsupported", "ambiguous"] },
          "operation": { "type": "string", "minLength": 1, "maxLength": 40 },
          "value": { "type": "string", "maxLength": 1000 },
          "unit": { "type": "string", "maxLength": 100 },
          "method": { "type": "string", "minLength": 1, "maxLength": 500 },
          "assumptions": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 500 } },
          "errorBound": { "type": "string", "maxLength": 100 }
        }
      },
      "examples": {
        "validInput": { "contractVersion": "1.2.0", "operation": "divide", "operands": ["1", "3"], "domain": "real", "precision": { "mode": "decimal", "decimalPlaces": 8 } },
        "invalidInput": { "contractVersion": "1.2.0", "operation": "divide", "operands": ["1", "0"], "domain": "real", "precision": { "mode": "decimal", "decimalPlaces": 80 }, "python": "import os" },
        "validResult": { "contractVersion": "1.2.0", "status": "approximate", "operation": "divide", "value": "0.33333333", "unit": "", "method": "decimal division", "assumptions": [], "errorBound": "<0.00000001" },
        "error": { "contractVersion": "1.2.0", "code": "division_by_zero", "message": "O divisor deve ser diferente de zero.", "retryable": false }
      }
    },
    {
      "name": "calculation.symbolic",
      "sideEffects": false,
      "description": "Simplify or substitute bounded rational polynomial expressions, or request another explicitly supported symbolic operation; the expression is mathematical text, not executable code.",
      "errorCodes": ["invalid_request", "invalid_expression", "unsupported_operation", "domain_error", "insufficient_data", "limit_exceeded", "unavailable", "internal_error"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/symbolic.input.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "operation", "expression", "variable", "domain", "substitutions", "precision"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "operation": { "enum": ["simplify", "substitute", "solve", "limit", "derivative", "integral"] },
          "expression": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "variable": { "type": "string", "minLength": 1, "maxLength": 64 },
          "domain": { "enum": ["real", "complex"] },
          "substitutions": { "type": "array", "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 64 }, "value": { "type": "string", "pattern": "^-?[0-9]+([.,][0-9]+)?$", "maxLength": 128 } } } },
          "precision": { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/symbolic.result.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "status", "operation", "expression", "value", "domain", "conditions"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "status": { "enum": ["exact", "approximate", "insufficient_data", "unsupported", "ambiguous"] },
          "operation": { "type": "string", "minLength": 1, "maxLength": 40 },
          "expression": { "type": "string", "maxLength": 4000 },
          "value": { "type": "string", "maxLength": 4000 },
          "domain": { "enum": ["real", "complex"] },
          "conditions": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } }
        }
      },
      "examples": {
        "validInput": { "contractVersion": "1.2.0", "operation": "simplify", "expression": "(x + y)^2", "variable": "x", "domain": "real", "substitutions": [], "precision": 0 },
        "invalidInput": { "contractVersion": "1.2.0", "operation": "execute_python", "expression": "__import__('os')", "variable": "x", "domain": "real", "substitutions": [], "precision": 0 },
        "validResult": { "contractVersion": "1.2.0", "status": "exact", "operation": "simplify", "expression": "(x + y)^2", "value": "x^2 + 2*x*y + y^2", "domain": "real", "conditions": [] },
        "error": { "contractVersion": "1.2.0", "code": "invalid_expression", "message": "A expressão não pertence à gramática matemática suportada.", "retryable": false }
      }
    },
    {
      "name": "calculation.solveEquation",
      "sideEffects": false,
      "description": "Solve one bounded rational polynomial equation in a declared real variable, distinguish no solution and identity cases, and verify returned roots against the original equation.",
      "errorCodes": ["invalid_request", "invalid_expression", "unsupported_operation", "domain_error", "insufficient_data", "limit_exceeded", "unavailable", "internal_error"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/solve-equation.input.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "equation", "variable", "domain"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "equation": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "variable": { "type": "string", "minLength": 1, "maxLength": 64 },
          "domain": { "enum": ["real", "complex"] }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/solve-equation.result.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "status", "equation", "variable", "domain", "value", "conditions", "solutionVerification"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "status": { "enum": ["exact", "no_solution", "indeterminate", "insufficient_data", "unsupported"] },
          "equation": { "type": "string", "maxLength": 4000 },
          "variable": { "type": "string", "minLength": 1, "maxLength": 64 },
          "domain": { "enum": ["real", "complex"] },
          "value": { "type": "string", "maxLength": 4000 },
          "conditions": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
          "solutionVerification": { "enum": ["verified", "not_checked"] }
        }
      },
      "examples": {
        "validInput": { "contractVersion": "1.2.0", "equation": "x^2 = 4", "variable": "x", "domain": "real" },
        "invalidInput": { "contractVersion": "1.2.0", "equation": "x^2 = 4", "variable": "x", "domain": "real", "shell": "whoami" },
        "validResult": { "contractVersion": "1.2.0", "status": "exact", "equation": "x^2 = 4", "variable": "x", "domain": "real", "value": "x = -2; x = 2", "conditions": [], "solutionVerification": "verified" },
        "error": { "contractVersion": "1.2.0", "code": "invalid_expression", "message": "A equação não pertence à gramática polinomial suportada.", "retryable": false }
      }
    },
    {
      "name": "calculation.solveSystem",
      "sideEffects": false,
      "description": "Solve a bounded system of linear rational equations over the declared real variables, distinguish inconsistent and underdetermined systems, and verify returned assignments against every original equation.",
      "errorCodes": ["invalid_request", "invalid_expression", "unsupported_operation", "domain_error", "insufficient_data", "limit_exceeded", "unavailable", "internal_error"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/solve-system.input.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "equations", "variables", "domain"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "equations": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 3, "maxLength": 4000 } },
          "variables": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
          "domain": { "enum": ["real", "complex"] }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/solve-system.result.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "status", "equations", "variables", "domain", "value", "conditions", "solutionVerification"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "status": { "enum": ["exact", "no_solution", "indeterminate", "insufficient_data", "unsupported"] },
          "equations": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 3, "maxLength": 4000 } },
          "variables": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
          "domain": { "enum": ["real", "complex"] },
          "value": { "type": "string", "maxLength": 4000 },
          "conditions": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
          "solutionVerification": { "enum": ["verified", "not_checked"] }
        }
      },
      "examples": {
        "validInput": { "contractVersion": "1.2.0", "equations": ["x + y = 5", "x - y = 1"], "variables": ["x", "y"], "domain": "real" },
        "invalidInput": { "contractVersion": "1.2.0", "equations": ["x + y = 5"], "variables": ["x", "y"], "domain": "real", "shell": "whoami" },
        "validResult": { "contractVersion": "1.2.0", "status": "exact", "equations": ["x + y = 5", "x - y = 1"], "variables": ["x", "y"], "domain": "real", "value": "x = 3; y = 2", "conditions": [], "solutionVerification": "verified" },
        "error": { "contractVersion": "1.2.0", "code": "invalid_expression", "message": "Uma ou mais equações não pertencem à gramática linear suportada.", "retryable": false }
      }
    },
    {
      "name": "calculation.convertUnits",
      "sideEffects": false,
      "description": "Convert a numeric quantity only when source and target units are recognized and dimensionally compatible.",
      "errorCodes": ["invalid_request", "unit_mismatch", "unsupported_operation", "limit_exceeded", "unavailable", "internal_error"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/convert-units.input.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "amount", "sourceUnit", "targetUnit", "decimalPlaces"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "amount": { "type": "string", "pattern": "^-?[0-9]+([.,][0-9]+)?$", "maxLength": 128 },
          "sourceUnit": { "type": "string", "minLength": 1, "maxLength": 64 },
          "targetUnit": { "type": "string", "minLength": 1, "maxLength": 64 },
          "decimalPlaces": { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/convert-units.result.schema.json",
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "status", "originalAmount", "convertedAmount", "sourceUnit", "targetUnit", "precision"],
        "properties": {
          "contractVersion": { "const": "1.2.0" },
          "status": { "enum": ["exact", "approximate", "unsupported", "insufficient_data"] },
          "originalAmount": { "type": "string", "maxLength": 128 },
          "convertedAmount": { "type": "string", "maxLength": 128 },
          "sourceUnit": { "type": "string", "maxLength": 64 },
          "targetUnit": { "type": "string", "maxLength": 64 },
          "precision": { "type": "string", "maxLength": 100 }
        }
      },
      "examples": {
        "validInput": { "contractVersion": "1.2.0", "amount": "1.5", "sourceUnit": "km", "targetUnit": "m", "decimalPlaces": 2 },
        "invalidInput": { "contractVersion": "1.2.0", "amount": "1.5", "sourceUnit": "kg", "targetUnit": "m", "decimalPlaces": -1 },
        "validResult": { "contractVersion": "1.2.0", "status": "exact", "originalAmount": "1.5", "convertedAmount": "1500", "sourceUnit": "km", "targetUnit": "m", "precision": "exact" },
        "error": { "contractVersion": "1.2.0", "code": "unit_mismatch", "message": "As unidades não têm dimensão compatível.", "retryable": false }
      }
    },
    {
      "name": "calculation.addQuantities",
      "sideEffects": false,
      "description": "Add two recognized quantities only when their dimensions are compatible; preserve original and normalized exact values.",
      "errorCodes": [
        "invalid_request",
        "unit_mismatch",
        "unsupported_operation",
        "limit_exceeded",
        "unavailable",
        "internal_error"
      ],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/add-quantities.input.schema.json",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "quantities"
        ],
        "properties": {
          "contractVersion": {
            "const": "1.2.0"
          },
          "quantities": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "unit"
              ],
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^-?(?:[0-9]+(?:[.,][0-9]+)?|[0-9]+/[1-9][0-9]*)$",
                  "maxLength": 128
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            }
          }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://sofiee-agent-calculation.local/contracts/v1/add-quantities.result.schema.json",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "status",
          "originalQuantities",
          "normalizedQuantities",
          "sum",
          "unit",
          "precision"
        ],
        "properties": {
          "contractVersion": {
            "const": "1.2.0"
          },
          "status": {
            "enum": [
              "exact",
              "unsupported"
            ]
          },
          "originalQuantities": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "unit"
              ],
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^-?(?:[0-9]+(?:[.,][0-9]+)?|[0-9]+/[1-9][0-9]*)$",
                  "maxLength": 128
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            }
          },
          "normalizedQuantities": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "unit"
              ],
              "properties": {
                "amount": {
                  "type": "string",
                  "maxLength": 128
                },
                "unit": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            }
          },
          "sum": {
            "type": "string",
            "maxLength": 128
          },
          "unit": {
            "type": "string",
            "maxLength": 64
          },
          "precision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "examples": {
        "validInput": {
          "contractVersion": "1.2.0",
          "quantities": [
            {
              "amount": "1",
              "unit": "km"
            },
            {
              "amount": "500",
              "unit": "m"
            }
          ]
        },
        "invalidInput": {
          "contractVersion": "1.2.0",
          "quantities": [
            {
              "amount": "1",
              "unit": "m"
            }
          ]
        },
        "validResult": {
          "contractVersion": "1.2.0",
          "status": "exact",
          "originalQuantities": [
            {
              "amount": "1",
              "unit": "km"
            },
            {
              "amount": "500",
              "unit": "m"
            }
          ],
          "normalizedQuantities": [
            {
              "amount": "1",
              "unit": "km"
            },
            {
              "amount": "1/2",
              "unit": "km"
            }
          ],
          "sum": "3/2",
          "unit": "km",
          "precision": "Exact rational conversions; original quantities are retained."
        },
        "error": {
          "contractVersion": "1.2.0",
          "code": "unit_mismatch",
          "message": "As grandezas têm dimensões incompatíveis.",
          "retryable": false
        }
      }
    }
  ]
}
